<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>AppGroupId</key>
    <string>$(CUSTOM_GROUP_ID)</string>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array><string>app.ilyich.native.backup.processing</string><string>app.ilyich.native.backup.refresh</string></array>
    <key>UIBackgroundModes</key>
    <array><string>processing</string><string>fetch</string></array>
    <key>CFBundleDisplayName</key>
    <string>Ilyich</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Connect to your server and discover Cast devices on your local network.</string>
    <key>NSBonjourServices</key>
    <array><string>_googlecast._tcp</string><string>_CC1AD845._googlecast._tcp</string></array>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Show the photos and videos on this iPhone, back them up to your server, and favorite or remove them when you ask.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Save photos and videos from Ilyich to your photo library.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Use Face ID to unlock your locked folder.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Use your location when you choose where a photo was taken or ask Ilyich to read your current Wi-Fi name for local server connections.</string>
    <key>NSLocationTemporaryUsageDescriptionDictionary</key>
    <dict>
        <key>WiFiNetworkName</key>
        <string>Precise location access is needed only when you ask Ilyich to read the connected Wi-Fi name for a local server address.</string>
    </dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>app.ilyich.native</string>
            <key>CFBundleURLSchemes</key><array><string>ilyich</string></array>
        </dict>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
